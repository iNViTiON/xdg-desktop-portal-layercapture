[Unit]
Description=xdg-desktop-portal InputCapture backend for niri (layer-shell barrier + EIS)
# Restart together with the frontend. No After=: xdg-desktop-portal D-Bus-activates this
# service during its own startup and waits for it.
PartOf=xdg-desktop-portal.service

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.layercapture
ExecStart=@bindir@/xdg-desktop-portal-layercapture
Restart=on-failure
RestartSec=1s
# SIGTERM releases any capture; don't wait long if the process is wedged.
TimeoutStopSec=2
# PID file, instance lock and watchdog log ($XDG_RUNTIME_DIR/layercapture); ProtectHome makes
# the rest of /run/user read-only.
RuntimeDirectory=layercapture
# Keep the watchdog log when the service restarts after a watchdog exit.
RuntimeDirectoryPreserve=restart
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
